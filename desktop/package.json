{
  "name": "roads-of-the-north-pc",
  "version": "1.0.0",
  "description": "Roads of the North for Windows",
  "main": "main.js",
  "author": "R3MC10",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.r3mc10.roadsofthenorth",
    "productName": "Roads of the North",
    "files": [
      "main.js",
      "www/**/*",
      "icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "artifactName": "RoadsOfTheNorth-${arch}-${target}.${ext}",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "RoadsOfTheNorth-PC-portable.exe"
    },
    "nsis": {
      "artifactName": "RoadsOfTheNorth-PC-setup.exe",
      "oneClick": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/R3MC10/Skyrim-Roads/releases/latest/download"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
